{
  "name": "sortsite-tools-by-ecomback",
  "version": "1.0.0",
  "private": true,
  "description": "SortSite Tools by Ecomback - website quality scanner",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./web --ignore ./data server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "tsx server/scripts/seed.ts",
    "reset": "rm -rf data && tsx server/scripts/seed.ts"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/css-tree": "^3.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/nspell": "^2.1.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "@mdn/browser-compat-data": "^8.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "css-tree": "^3.2.1",
    "dictionary-de": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "docx": "^9.12.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "framer-motion": "^14.4.0",
    "html-validate": "^11.16.4",
    "lucide-react": "^0.460.0",
    "nodemailer": "^10.1.7",
    "nspell": "^2.1.5",
    "puppeteer-core": "^25.14.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.10.1",
    "robots-parser": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.4"
  }
}
